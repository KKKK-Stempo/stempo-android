<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.view.View" />

        <variable
            name="vm"
            type="com.kkkk.presentation.main.rhythm.RhythmViewModel" />

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/shape_white_fill_top20_rect"
        android:paddingBottom="24dp">

        <View
            android:id="@+id/iv_handler"
            android:layout_width="42dp"
            android:layout_height="4dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/shape_gray500_fill_100_rect"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_rhythm_bit_title"
            style="@style/TextAppearance.Stempo.Head4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="14dp"
            android:text="박자 선택"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/iv_handler" />

        <GridLayout
            android:id="@+id/layout_grid_bit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="10dp"
            android:columnCount="2"
            android:rowCount="3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_rhythm_bit_title">

            <TextView
                style="@style/TextAppearance.Stempo.Head2"
                android:layout_row="0"
                android:layout_rowWeight="1"
                android:layout_column="0"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                android:background="@{vm.tempBit == 2 ? @drawable/shape_purple50_fill_17_rect : @drawable/shape_gray200_fill_17_rect}"
                android:gravity="center"
                android:onClick="@{() -> vm.setTempBit(2)}"
                android:paddingVertical="12dp"
                android:text="2 박자"
                android:textColor="@{vm.tempBit == 2 ? @color/white : @color/gray_600}"
                tools:background="@drawable/shape_gray200_fill_17_rect" />

            <TextView
                style="@style/TextAppearance.Stempo.Head2"
                android:layout_row="0"
                android:layout_rowWeight="1"
                android:layout_column="1"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                android:background="@{vm.tempBit == 3 ? @drawable/shape_purple50_fill_17_rect : @drawable/shape_gray200_fill_17_rect}"
                android:gravity="center"
                android:onClick="@{() -> vm.setTempBit(3)}"
                android:paddingVertical="12dp"
                android:text="3 박자"
                android:textColor="@{vm.tempBit == 3 ? @color/white : @color/gray_600}"
                tools:background="@drawable/shape_gray200_fill_17_rect" />

            <TextView
                style="@style/TextAppearance.Stempo.Head2"
                android:layout_row="1"
                android:layout_rowWeight="1"
                android:layout_column="0"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                android:background="@{vm.tempBit == 4 ? @drawable/shape_purple50_fill_17_rect : @drawable/shape_gray200_fill_17_rect}"
                android:gravity="center"
                android:onClick="@{() -> vm.setTempBit(4)}"
                android:paddingVertical="12dp"
                android:text="4 박자"
                android:textColor="@{vm.tempBit == 4 ? @color/white : @color/gray_600}"
                tools:background="@drawable/shape_gray200_fill_17_rect" />

            <TextView
                style="@style/TextAppearance.Stempo.Head2"
                android:layout_row="1"
                android:layout_rowWeight="1"
                android:layout_column="1"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                android:background="@{vm.tempBit == 6 ? @drawable/shape_purple50_fill_17_rect : @drawable/shape_gray200_fill_17_rect}"
                android:gravity="center"
                android:onClick="@{() -> vm.setTempBit(6)}"
                android:paddingVertical="12dp"
                android:text="6 박자"
                android:textColor="@{vm.tempBit == 6 ? @color/white : @color/gray_600}"
                tools:background="@drawable/shape_gray200_fill_17_rect" />

            <TextView
                style="@style/TextAppearance.Stempo.Head2"
                android:layout_row="2"
                android:layout_rowWeight="1"
                android:layout_column="0"
                android:layout_columnWeight="1"
                android:layout_margin="8dp"
                android:background="@{vm.tempBit == 8 ? @drawable/shape_purple50_fill_17_rect : @drawable/shape_gray200_fill_17_rect}"
                android:gravity="center"
                android:onClick="@{() -> vm.setTempBit(8)}"
                android:paddingVertical="12dp"
                android:text="8 박자"
                android:textColor="@{vm.tempBit == 8 ? @color/white : @color/gray_600}"
                tools:background="@drawable/shape_gray200_fill_17_rect" />


        </GridLayout>

        <View
            android:id="@+id/border_rhythm"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="24dp"
            android:background="@color/gray_300"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layout_grid_bit" />

        <TextView
            android:id="@+id/tv_rhythm_bpm_title"
            style="@style/TextAppearance.Stempo.Head4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="8dp"
            android:text="빠르기 선택"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/border_rhythm" />

        <TextView
            android:id="@+id/tv_rhythm_bpm"
            style="@style/TextAppearance.Stempo.Head1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="@{String.valueOf(vm.tempBpm)}"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_rhythm_bpm_title"
            tools:text="65" />

        <ImageView
            android:id="@+id/btn_bpm_minus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="60dp"
            android:onClick="@{() -> vm.minusTempBpm()}"
            android:src="@{vm.isBpmMinusAvailable ? @drawable/ic_minus_purple : @drawable/ic_minus_gray}"
            app:layout_constraintBottom_toBottomOf="@id/tv_rhythm_bpm"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_rhythm_bpm"
            tools:src="@drawable/ic_minus_purple" />

        <ImageView
            android:id="@+id/btn_bpm_plus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="60dp"
            android:onClick="@{() -> vm.plusTempBpm()}"
            android:src="@{vm.isBpmPlusAvailable ? @drawable/ic_plus_purple : @drawable/ic_plus_gray}"
            app:layout_constraintBottom_toBottomOf="@id/tv_rhythm_bpm"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_rhythm_bpm"
            tools:src="@drawable/ic_plus_purple" />

        <GridLayout
            android:id="@+id/layout_grid_bpm"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="40dp"
            android:columnCount="3"
            android:rowCount="2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_rhythm_bpm">

            <TextView
                style="@style/TextAppearance.Stempo.Head3"
                android:layout_row="0"
                android:layout_rowWeight="1"
                android:layout_column="0"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:background="@{vm.tempBpm == 65 ? @drawable/shape_white_fill_purple50_line_25_rect : @drawable/shape_gray100_fill_gray300_line_25_rect}"
                android:gravity="center"
                android:onClick="@{() -> vm.setTempBpm(65)}"
                android:paddingVertical="12dp"
                android:text="65"
                android:textColor="@{vm.tempBpm == 65 ? @color/purple_50 : @color/gray_500}"
                tools:background="@drawable/shape_gray100_fill_gray300_line_25_rect" />

            <TextView
                style="@style/TextAppearance.Stempo.Head3"
                android:layout_row="0"
                android:layout_rowWeight="1"
                android:layout_column="1"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:background="@{vm.tempBpm == 75 ? @drawable/shape_white_fill_purple50_line_25_rect : @drawable/shape_gray100_fill_gray300_line_25_rect}"
                android:gravity="center"
                android:onClick="@{() -> vm.setTempBpm(75)}"
                android:paddingVertical="12dp"
                android:text="75"
                android:textColor="@{vm.tempBpm == 75 ? @color/purple_50 : @color/gray_500}"
                tools:background="@drawable/shape_gray100_fill_gray300_line_25_rect" />

            <TextView
                style="@style/TextAppearance.Stempo.Head3"
                android:layout_row="0"
                android:layout_rowWeight="1"
                android:layout_column="2"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:background="@{vm.tempBpm == 85 ? @drawable/shape_white_fill_purple50_line_25_rect : @drawable/shape_gray100_fill_gray300_line_25_rect}"
                android:gravity="center"
                android:onClick="@{() -> vm.setTempBpm(85)}"
                android:paddingVertical="12dp"
                android:text="85"
                android:textColor="@{vm.tempBpm == 85 ? @color/purple_50 : @color/gray_500}"
                tools:background="@drawable/shape_gray100_fill_gray300_line_25_rect" />

            <TextView
                style="@style/TextAppearance.Stempo.Head3"
                android:layout_row="1"
                android:layout_rowWeight="1"
                android:layout_column="0"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:background="@{vm.tempBpm == 95 ? @drawable/shape_white_fill_purple50_line_25_rect : @drawable/shape_gray100_fill_gray300_line_25_rect}"
                android:gravity="center"
                android:onClick="@{() -> vm.setTempBpm(95)}"
                android:paddingVertical="12dp"
                android:text=" 95 "
                android:textColor="@{vm.tempBpm == 95 ? @color/purple_50 : @color/gray_500}"
                tools:background="@drawable/shape_gray100_fill_gray300_line_25_rect" />

            <TextView
                style="@style/TextAppearance.Stempo.Head3"
                android:layout_row="1"
                android:layout_rowWeight="1"
                android:layout_column="1"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:background="@{vm.tempBpm == 105 ? @drawable/shape_white_fill_purple50_line_25_rect : @drawable/shape_gray100_fill_gray300_line_25_rect}"
                android:gravity="center"
                android:onClick="@{() -> vm.setTempBpm(105)}"
                android:paddingVertical="12dp"
                android:text="105"
                android:textColor="@{vm.tempBpm == 105 ? @color/purple_50 : @color/gray_500}"
                tools:background="@drawable/shape_gray100_fill_gray300_line_25_rect" />

            <TextView
                style="@style/TextAppearance.Stempo.Head3"
                android:layout_row="1"
                android:layout_rowWeight="1"
                android:layout_column="2"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:background="@{vm.tempBpm == 115 ? @drawable/shape_white_fill_purple50_line_25_rect : @drawable/shape_gray100_fill_gray300_line_25_rect}"
                android:gravity="center"
                android:onClick="@{() -> vm.setTempBpm(115)}"
                android:paddingVertical="12dp"
                android:text="115"
                android:textColor="@{vm.tempBpm == 115 ? @color/purple_50 : @color/gray_500}"
                tools:background="@drawable/shape_gray100_fill_gray300_line_25_rect" />

        </GridLayout>

        <TextView
            android:id="@+id/btn_submit_level"
            style="@style/TextAppearance.Stempo.Head4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/shape_purple10_fill_12_rect"
            android:gravity="center"
            android:paddingVertical="15dp"
            android:text="@string/rhythm_btn_submit_level"
            android:textColor="@color/purple_50"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layout_grid_bpm" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>